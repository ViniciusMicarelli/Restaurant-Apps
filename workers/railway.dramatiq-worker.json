{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/Dockerfile"
  },
  "deploy": {
    "startCommand": "dramatiq src.async_tasks --processes 2 --threads 8",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
