# =============================================================================
# AMBIENTE DE PRODUÇÃO — RESTAURANT APPS PLATFORM
# Copie para `.env.prod` (nunca commitado) e preencha com os valores reais do
# ambiente de destino. Usado por `infra/docker/docker-compose.prod.yml`.
#
# IMPORTANTE: o PostgreSQL NÃO sobe como container em produção — `DB__HOST`
# deve apontar para uma instância gerenciada/dedicada (RDS, Cloud SQL, um
# servidor Postgres próprio, etc). Redis/RabbitMQ/Meilisearch continuam
# containerizados nesta fase (decisão registrada em
# docs/deploy/infrastructure_strategy.md) — migrar para serviços gerenciados
# no futuro não exige mudança de código, só destas variáveis.
#
# NENHUMA variável de ambiente deve estar hardcoded no código-fonte!
# =============================================================================

# --- Ambiente global ---------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL — instância EXTERNA e dedicada (nunca um container) --------
DB__HOST=CHANGE_ME_your-managed-postgres-host.example.com
DB__PORT=5432
DB__USER=CHANGE_ME_db_app_user
DB__PASSWORD=CHANGE_ME_use_a_real_secret_manager_value

# --- Nome do banco de cada microsserviço (Database-per-Service) ------------
AUTH_DB_NAME=auth_db
RESTAURANT_DB_NAME=restaurant_db
MENU_DB_NAME=menu_db
DINING_DB_NAME=dining_db
KITCHEN_DB_NAME=kitchen_db
ORDERS_DB_NAME=orders_db
INVENTORY_DB_NAME=inventory_db
PAYMENTS_DB_NAME=payments_db
DELIVERY_DB_NAME=delivery_db
MARKETING_DB_NAME=marketing_db
NOTIFICATIONS_DB_NAME=notifications_db
ANALYTICS_DB_NAME=analytics_db

# --- Redis (container na mesma stack de produção) ---------------------------
REDIS_HOST=redis-cache
REDIS_PORT=6379
AUTH_REDIS_DB=0
RESTAURANT_REDIS_DB=1
MENU_REDIS_DB=2
DINING_REDIS_DB=3
ORDERS_REDIS_DB=4
KITCHEN_REDIS_DB=5
INVENTORY_REDIS_DB=6
PAYMENTS_REDIS_DB=7
NOTIFICATIONS_REDIS_DB=8
ANALYTICS_REDIS_DB=9
DELIVERY_REDIS_DB=10
MARKETING_REDIS_DB=11
WORKERS_REDIS_DB=12

# --- RabbitMQ (container na mesma stack de produção) ------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME_rabbitmq_user
RABBITMQ_PASS=CHANGE_ME_use_a_real_secret_manager_value

# --- Meilisearch (container na mesma stack de produção) ---------------------
MEILI_HOST=meilisearch
MEILI_PORT=7700
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_use_a_real_secret_manager_value
MEILI_ENV=production

# --- Segredos JWT (compartilhado entre todos os serviços) ------------------
JWT_SECRET_KEY=CHANGE_ME_use_a_real_secret_manager_value_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Portas internas de cada microsserviço (não expostas ao host; só o -----
# --- Nginx em infra/nginx é publicado externamente, ver docker-compose.prod.yml)
AUTH_SERVICE_PORT=8000
RESTAURANT_SERVICE_PORT=8001
MENU_SERVICE_PORT=8002
DINING_SERVICE_PORT=8003
KITCHEN_SERVICE_PORT=8004
ORDER_SERVICE_PORT=8005
INVENTORY_SERVICE_PORT=8006
PAYMENT_SERVICE_PORT=8007
DELIVERY_SERVICE_PORT=8008
MARKETING_SERVICE_PORT=8009
NOTIFICATION_SERVICE_PORT=8010
ANALYTICS_SERVICE_PORT=8011

# --- Endpoints públicos consumidos pelos frontends (build-time do Vite) ----
# IMPORTANTE: `VITE_*` é embutido no bundle estático em BUILD time, não lido
# em runtime — num deploy via imagem Docker (ex: Railway, ver
# docs/deploy/railway_setup.md) precisam ser passados como build args, não
# só variável de ambiente do container já rodando. Lista abaixo é a união
# do que `admin-web` e `customer-web` realmente importam (`grep -r VITE_
# apps/*/src` confirma) — divergia do que este arquivo listava antes.
VITE_API_GATEWAY_URL=https://CHANGE_ME.example.com
VITE_AUTH_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/auth
VITE_RESTAURANT_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/restaurant
VITE_MENU_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/menu
VITE_DINING_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/dining
VITE_KITCHEN_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/kitchen
VITE_KITCHEN_WS_URL=wss://CHANGE_ME.example.com/ws/v1/kitchen/kds
VITE_ORDER_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/orders
VITE_PAYMENT_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/payments
VITE_NOTIFICATION_SERVICE_URL=https://CHANGE_ME.example.com/api/v1/notifications
# admin-web só (link "abrir cardápio do cliente" a partir do painel).
VITE_CUSTOMER_WEB_URL=https://CHANGE_ME-customer.example.com
# customer-web só, OPCIONAL — só faz sentido se o domínio do customer-web
# atender sempre o mesmo restaurante sem `?r=slug` na URL (não é o caso
# hoje: o QR Code de cada mesa já inclui o slug). Deixar em branco em
# produção normalmente.
VITE_DEFAULT_RESTAURANT_SLUG=
