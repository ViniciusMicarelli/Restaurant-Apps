# =============================================================================
# AMBIENTE DE DESENVOLVIMENTO — RESTAURANT APPS PLATFORM
# Copie este arquivo para `.env.dev` (nunca commitado) e ajuste se necessário.
# Usado por `infra/docker/docker-compose.dev.yml`. Postgres/Redis/RabbitMQ/
# Meilisearch sobem como containers locais — nada aqui aponta para produção.
# NENHUMA variável de ambiente deve estar hardcoded no código-fonte!
# =============================================================================

# --- Ambiente global ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- PostgreSQL (container local — cluster único, um DB por serviço) --------
POSTGRES_USER=postgres_app_user
POSTGRES_PASSWORD=dev_only_postgres_password_change_me
POSTGRES_DB=restaurant_platform_db
DB__HOST=postgres-db
DB__PORT=5432
DB__USER=postgres_app_user
DB__PASSWORD=dev_only_postgres_password_change_me

# --- Nome do banco de cada microsserviço (Database-per-Service) ------------
AUTH_DB_NAME=auth_db
RESTAURANT_DB_NAME=restaurant_db
MENU_DB_NAME=menu_db
DINING_DB_NAME=dining_db
KITCHEN_DB_NAME=kitchen_db
ORDERS_DB_NAME=orders_db
INVENTORY_DB_NAME=inventory_db
PAYMENTS_DB_NAME=payments_db
DELIVERY_DB_NAME=delivery_db
MARKETING_DB_NAME=marketing_db
NOTIFICATIONS_DB_NAME=notifications_db
ANALYTICS_DB_NAME=analytics_db

# --- Redis (container local — 1 DB numerado por serviço, ver DATABASE.md) --
REDIS_HOST=redis-cache
REDIS_PORT=6379
AUTH_REDIS_DB=0
RESTAURANT_REDIS_DB=1
MENU_REDIS_DB=2
DINING_REDIS_DB=3
ORDERS_REDIS_DB=4
KITCHEN_REDIS_DB=5
INVENTORY_REDIS_DB=6
PAYMENTS_REDIS_DB=7
NOTIFICATIONS_REDIS_DB=8
ANALYTICS_REDIS_DB=9
DELIVERY_REDIS_DB=10
MARKETING_REDIS_DB=11
WORKERS_REDIS_DB=12

# --- RabbitMQ (container local — barramento de eventos de domínio) ---------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=restaurant_rabbit
RABBITMQ_PASS=dev_only_rabbitmq_password_change_me

# --- Meilisearch (container local — busca do cardápio digital) -------------
MEILI_HOST=meilisearch
MEILI_PORT=7700
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev_only_meili_master_key_change_me
MEILI_ENV=development

# --- Segredos JWT (compartilhado entre todos os serviços) ------------------
JWT_SECRET_KEY=dev_only_jwt_signing_key_min_32_characters_long_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Portas de cada microsserviço (host == container em dev) ---------------
AUTH_SERVICE_PORT=8000
RESTAURANT_SERVICE_PORT=8001
MENU_SERVICE_PORT=8002
DINING_SERVICE_PORT=8003
KITCHEN_SERVICE_PORT=8004
ORDER_SERVICE_PORT=8005
INVENTORY_SERVICE_PORT=8006
PAYMENT_SERVICE_PORT=8007
DELIVERY_SERVICE_PORT=8008
MARKETING_SERVICE_PORT=8009
NOTIFICATION_SERVICE_PORT=8010
ANALYTICS_SERVICE_PORT=8011

# --- Endpoints consumidos pelos frontends (Vite) ----------------------------
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_AUTH_SERVICE_URL=http://localhost:8000
VITE_RESTAURANT_SERVICE_URL=http://localhost:8001
VITE_MENU_SERVICE_URL=http://localhost:8002
VITE_DINING_SERVICE_URL=http://localhost:8003
VITE_KITCHEN_SERVICE_URL=http://localhost:8004
VITE_KITCHEN_WS_URL=ws://localhost:8004/ws/v1/kitchen/kds
VITE_ORDER_SERVICE_URL=http://localhost:8005
VITE_PAYMENT_SERVICE_URL=http://localhost:8007
# Slug de demonstração usado pelo customer-web quando a URL não traz `?r=<slug>`
# (o QR Code real de cada mesa sempre inclui o slug do restaurante).
VITE_DEFAULT_RESTAURANT_SLUG=
